{
  "compilerOptions": {
    "target": "ES2020",
    "baseUrl": ".",
    "paths": {
    "@/": ["src/*"]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "es2021"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/types/**/*.d.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/Desktop/CursorRecoveredFiles/**",
    "**/CursorRecoveredFiles/**",
    "Cell*.tsx",
    "GridOverlay.tsx",
    "ChuckSetup.tsx",
    "ControlPanel.tsx",
    "OldKeyboardPanel.tsx",
    "OldLaunchScreen.tsx",
    "GridCell.tsx",
    "BeatGridTooltip.tsx"
  ]
}
